---
layout: layouts/base.njk
title: false
---
{% from "macros/section-row.njk" import sectionRow %}
<section class="hero">
  <div
    class="map map-overview"
    data-src="{{ '/api/sections.json' | url }}"
    data-tiles="{{ site.tiles.url }}"
    data-attribution="{{ site.tiles.attribution }}"
    data-maxzoom="{{ site.tiles.maxZoom }}"
    data-route="{{ site.route | dump }}"
    role="img"
    aria-label="Map of the whole South West Coast Path route"
  ></div>
  <div class="hero-text">
    <h1>{{ site.title }}</h1>
    <p class="lede">{{ site.tagline }}</p>
  </div>
</section>

<section class="overview">
  {% for region in collections.regionsWithSections %}
  {% if region.sections | length %}
  <div class="region-block">
    <h2><a href="/regions/{{ region.slug }}/">{{ region.name }}</a></h2>
    <ol class="section-list">
      {% for s in region.sections %}{{ sectionRow(s) }}{% endfor %}
    </ol>
  </div>
  {% endif %}
  {% endfor %}
</section>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""></script>
<script src="https://unpkg.com/leaflet-gpx@1.7.0/gpx.js"></script>
<script src="{{ '/assets/js/map-overview.js' | asset }}"></script>
