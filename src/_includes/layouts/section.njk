---
layout: layouts/base.njk
---
<article class="section">
  <div class="section-head">
    <p class="section-meta">
      Section {{ order }}{% if region %} · {{ region | regionName }}{% endif %}
    </p>
    <h1>{{ title }}</h1>
    <p class="section-route">{{ startPlace.name or start }} &rarr; {{ endPlace.name or end }}</p>
  </div>

  {% set nav = collections.sections | sectionNav(page.url) %}
  <nav class="section-nav" aria-label="Sections">
    {% if nav.prev %}
    <a class="nav-prev" href="{{ nav.prev.url }}">
      <span class="nav-arrow" aria-hidden="true">&larr;</span>
      <span class="nav-label">{{ nav.prev.order }} · {{ nav.prev.title }}</span>
    </a>
    {% else %}<span class="nav-none"></span>{% endif %}

    <span class="nav-count">{{ nav.position }} of {{ nav.total }}</span>

    {% if nav.next %}
    <a class="nav-next" href="{{ nav.next.url }}">
      <span class="nav-label">{{ nav.next.order }} · {{ nav.next.title }}</span>
      <span class="nav-arrow" aria-hidden="true">&rarr;</span>
    </a>
    {% else %}<span class="nav-none"></span>{% endif %}
  </nav>

  <nav class="section-jump" aria-label="On this page">
    {% if content %}<a href="#notes">Notes</a>{% endif %}
    {% if services.length or transfers.length or shops or eat or transitLink %}<a href="#transport">Transport</a>{% endif %}
    {% if nearby.escape.length %}<a href="#escapes">Escapes</a>{% endif %}
    {% if nearby.stay.length %}<a href="#stays">Stays</a>{% endif %}
    {% if nearby.hospital.length or nearby.vet.length %}<a href="#emergency">Emergency</a>{% endif %}
  </nav>

  {% if gpx %}
  <div
    class="map map-section"
    data-gpx="{{ gpx | url }}"
    data-tiles="{{ site.tiles.url }}"
    data-attribution="{{ site.tiles.attribution }}"
    data-maxzoom="{{ site.tiles.maxZoom }}"
    data-route="{{ site.route | dump }}"
    data-stays="{{ mapPins | staysForMap | dump }}"
    data-emergency="{{ emergencyPins | staysForMap | dump }}"
    role="img"
    aria-label="Route map from {{ startPlace.name or start }} to {{ endPlace.name or end }}"
  ></div>
  {% endif %}

  {% if os_url %}
  {# Plain link, no target: gives the OS Maps app first refusal on a phone. #}
  <p class="map-link"><a href="{{ os_url }}">Open this route in OS Maps</a></p>
  {% endif %}

  <dl class="facts">
    {% if distance_km %}<dt>Distance</dt><dd>{{ distance_km }} km</dd>{% endif %}
    {% if ascent_m %}<dt>Ascent</dt><dd>{{ ascent_m }} m</dd>{% endif %}
    {% if mode %}<dt>Approach</dt><dd>{{ mode }}</dd>{% endif %}
  </dl>

  {% if content %}
  <section class="notes" id="notes">{{ content | safe }}</section>
  {% endif %}

  {% if services.length or transfers.length or shops or eat or transitLink %}
  <section class="logistics" id="transport">
    <h2>Getting there &amp; back</h2>

    {% if transitLink %}
    <p class="transit-all">
      <a class="stay-directions" href="{{ transitLink }}">All public transport from {{ startPlace.name }} to {{ endPlace.name }}</a>
      <span class="transit-note">buses, trains and ferries, live in Google Maps. Walking distances below are straight-line, so allow a little more on the ground.</span>
    </p>
    {% endif %}

    {% if services.length %}
    <ul class="service-list">
      {% for r in services %}
      <li>
        <p class="service-head">
          <span class="service-number">{{ r.number }}</span>
          <strong>{% if r.url %}<a href="{{ r.url }}">{{ r.name }}</a>{% else %}{{ r.name }}{% endif %}</strong>
          {% if r.provider %}<span class="service-op">{{ r.provider.name }}</span>{% endif %}
          {% if r.linksEnds %}<span class="stay-flag yes">links both ends</span>
          {% elif r.stretch and not anyServiceLinksEnds %}<span class="stay-flag unsure">a walk at one end</span>
          {% elif r.stretch %}<span class="stay-flag unsure">further out</span>
          {% else %}<span class="stay-flag unsure">escape points only</span>{% endif %}
        </p>
        <dl class="stay-facts">
          <dt>Calls at</dt>
          <dd>{% for c in r.calling %}{{ c.name }}{% if not loop.last %}, {% endif %}{% endfor %}</dd>
          <dt>Walk to it</dt>
          <dd>
            {% if r.fromStart.km <= 0.2 and r.fromEnd.km <= 0.2 %}Stops at both ends of the section
            {% else %}
              {% if r.fromStart.km > 0.2 %}{{ r.fromStart.km }} km from {{ startPlace.name }} to {{ r.fromStart.stop.name }}{% else %}Stops at {{ startPlace.name }}{% endif %};
              {% if r.fromEnd.km > 0.2 %}{{ r.fromEnd.km }} km from {{ endPlace.name }} to {{ r.fromEnd.stop.name }}{% else %}stops at {{ endPlace.name }}{% endif %}
            {% endif %}
          </dd>
          <dt>Season</dt>
          <dd>{% if r.season %}{{ r.season | seasonText }}{% if r.frequency %} · {{ r.frequency }}{% endif %}{% else %}<span class="unsure">Not confirmed</span>{% endif %}</dd>
          {% if r.servesEscape %}
          <dt>Bail-out</dt>
          <dd>Calls at escape points on this section</dd>
          {% endif %}
        </dl>
        {% if r.notes %}<p class="stay-notes"><span class="notes-label">Notes</span> {{ r.notes }}</p>{% endif %}
        <p class="stay-checked">
          {% if r.verified %}Details checked {{ r.verified }}{% else %}<span class="unsure">Service details not confirmed — check before relying on them</span>{% endif %}
        </p>
      </li>
      {% endfor %}
    </ul>
    {% endif %}

    {% if transfers.length %}
    <h3>Lifts &amp; luggage</h3>
    <ul class="service-list">
      {% for t in transfers %}
      <li>
        <p class="service-head">
          <strong>{% if t.url %}<a href="{{ t.url }}">{{ t.name }}</a>{% else %}{{ t.name }}{% endif %}</strong>
          {% if "passenger" in t.services %}<span class="stay-flag yes">lifts</span>{% endif %}
          {% if "baggage" in t.services %}<span class="stay-flag">luggage</span>{% endif %}
        </p>
        <dl class="stay-facts">
          <dt>Covers</dt>
          <dd>{% if t.distanceKm == null %}{{ t.reaches }}{% else %}Based {{ t.distanceKm }} km from {{ t.reaches }}{% endif %}</dd>
          {% if t.hours %}<dt>Hours</dt><dd>{{ t.hours }}</dd>{% endif %}
          <dt>Dogs</dt>
          <dd>
            {% if t.dogs === true %}<span class="yes">Welcome</span>
            {% elif t.dogs === false %}<span class="no">Not allowed</span>
            {% else %}<span class="unsure">Not confirmed</span>{% endif %}
            {% if t.dogs_note %} — {{ t.dogs_note }}{% endif %}
          </dd>
          {% if t.phone %}<dt>Phone</dt><dd><a href="tel:{{ t.phone | replace(" ", "") }}">{{ t.phone }}</a></dd>{% endif %}
        </dl>
        {% if t.notes %}<p class="stay-notes"><span class="notes-label">Notes</span> {{ t.notes }}</p>{% endif %}
        <p class="stay-checked">
          {% if t.verified %}Details checked {{ t.verified }}{% else %}<span class="unsure">Details not confirmed</span>{% endif %}
        </p>
      </li>
      {% endfor %}
    </ul>
    {% endif %}

    {% if shops %}<p><strong>Shops &amp; dog food:</strong> {{ shops }}</p>{% endif %}
    {% if eat %}<p><strong>Eating out:</strong> {{ eat }}</p>{% endif %}
  </section>
  {% endif %}

  {% if nearby.escape and nearby.escape.length %}
  <section class="escapes" id="escapes">
    <h2>Escape points</h2>
    <ul class="escape-list">
      {% for e in nearby.escape %}
      <li>
        <p class="escape-head">
          {{ e | locBadge | safe }}
          <span class="e-km">{{ e.kmAlong }} km in</span>
          <strong>{{ e.name }}</strong>
          <span class="stay-dist">{{ e.toRoute }} km off the path</span>
          <button type="button" class="stay-focus" data-stay="{{ e.slug }}">Show on map</button>
        </p>
        {% if e.escape.detail %}<p class="escape-detail">{{ e.escape.detail }}</p>{% endif %}
        {% if e | directions %}<p class="escape-detail"><a class="stay-directions" href="{{ e | directions }}">Navigate with Google Maps</a></p>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% set stays = nearby.stay %}
  {% if stays and stays.length %}
  <section class="stays" id="stays">
    <div class="stays-head">
      <h2>Staying nearby</h2>
      <button type="button" class="stays-toggle" data-expand-all>Expand all</button>
    </div>
    <ul class="stay-list">
      {% for s in stays %}
      <li>
        <details class="stay">
        <summary>
          {{ s | locBadge | safe }}
          <span class="stay-name">{{ s.name }}</span>
          <span class="stay-kind">{{ s.stay.type | stayType }}</span>
          <span class="stay-dist">{{ s.nearest }} km from the {% if s.atEnd %}finish{% else %}start{% endif %}{% if s.toRoute <= 0.25 %}, on the route{% elif s.toRoute < (s.nearest - 0.3) %}, {{ s.toRoute }} km off the path{% endif %}</span>
          {% if s.stay.dogs === true %}<span class="stay-flag yes" title="Dogs welcome">dogs</span>
          {% elif s.stay.dogs === false %}<span class="stay-flag no" title="No dogs">no dogs</span>
          {% else %}<span class="stay-flag unsure" title="Dog policy not confirmed">dogs?</span>{% endif %}
          <button type="button" class="stay-focus" data-stay="{{ s.slug }}">Show on map</button>
        </summary>

        <dl class="stay-facts">
          {% if s.url %}
          <dt>Website</dt>
          <dd><a href="{{ s.url }}">{{ s.name }}</a></dd>
          {% endif %}
          {% if s.address %}
          <dt>Address</dt>
          <dd>{{ s.address }}</dd>
          {% endif %}

          <dt>Dogs</dt>
          <dd>
            {% if s.stay.dogs === true %}<span class="yes">Welcome</span>
            {% elif s.stay.dogs === false %}<span class="no">Not allowed</span>
            {% else %}<span class="unsure">Not confirmed</span>{% endif %}
            {% if s.stay.dogs_note %} — {{ s.stay.dogs_note }}{% endif %}
          </dd>

          <dt>Season</dt>
          <dd>{% if s.stay.season %}{{ s.stay.season | seasonText }}{% else %}<span class="unsure">{{ s.stay.season | seasonText }}</span>{% endif %}</dd>

          <dt>Price</dt>
          <dd>{% if s.stay.price_per_night %}{{ s.stay.price_per_night | priceText(s.stay.price_note) }}{% else %}<span class="unsure">{{ s.stay.price_per_night | priceText(s.stay.price_note) }}</span>{% endif %}</dd>

          {% if s.stay.hookup %}
          <dt>Hook-up</dt>
          <dd>Electric hook-up available</dd>
          {% endif %}

          {% if s.phone %}
          <dt>Phone</dt>
          <dd><a href="tel:{{ s.phone | replace(" ", "") }}">{{ s.phone }}</a></dd>
          {% endif %}

          {% if s | directions %}
          <dt>Drive there</dt>
          <dd><a class="stay-directions" href="{{ s | directions }}">Navigate with Google Maps</a></dd>
          {% endif %}
        </dl>

        {% if s.notes %}
        <p class="stay-notes"><span class="notes-label">Notes</span> {{ s.notes }}</p>
        {% endif %}

        <p class="stay-checked">
          {% if s.verified %}Details checked {{ s.verified }}{% else %}<span class="unsure">Details not yet confirmed with the owner</span>{% endif %}
        </p>
        </details>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if nearby.hospital.length or nearby.vet.length %}
  <section class="emergency" id="emergency">
    <h2>If something goes wrong</h2>
    <p class="emergency-lead">
      In a real emergency it's 999, wherever you are. What follows is the nearest
      few, however far away they happen to be — they're kept off the map because
      the nearest A&amp;E would zoom the route out to nothing. Distances are
      straight-line from this section and the times are rough; the map link gives
      the real answer, and routes from wherever you actually are. They do have
      pins — the map just doesn't zoom out to them, so pinch out or use "Show on
      map" to find one.
    </p>

    {% if nearby.hospital.length %}
    <h3>Hospitals</h3>
    <ul class="emergency-list">
      {% for h in nearby.hospital %}
      <li>
        <p class="emergency-head">
          <span class="emergency-kind {% if h.hospital.type == 'ae' %}is-ae{% endif %}">{% if h.hospital.type == "ae" %}A&amp;E{% else %}Urgent care{% endif %}</span>
          <strong>{{ h.name }}</strong>
          <span class="stay-dist">{{ h.nearest }} km · {{ h.nearest | driveTime }}</span>
          <button type="button" class="stay-focus" data-stay="{{ h.slug }}">Show on map</button>
        </p>
        <dl class="stay-facts">
          {% if h.address %}<dt>Address</dt><dd>{{ h.address }}</dd>{% endif %}
          {% if h.hours %}<dt>Open</dt><dd>{{ h.hours }}</dd>{% endif %}
          {% if h.phone %}<dt>Phone</dt><dd><a href="tel:{{ h.phone | replace(" ", "") }}">{{ h.phone }}</a></dd>{% endif %}
          {% if h | directions %}<dt>Map</dt><dd><a class="stay-directions" href="{{ h | directions }}">Open in Google Maps</a></dd>{% endif %}
        </dl>
        {% if h.notes %}<p class="stay-notes"><span class="notes-label">Notes</span> {{ h.notes }}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
    {% endif %}

    {% if nearby.vet.length %}
    <h3>Vets</h3>
    <ul class="emergency-list">
      {% for v in nearby.vet %}
      <li>
        <p class="emergency-head">
          <span class="emergency-kind{% if v.vet.emergency %} is-ae{% endif %}">{% if v.vet.emergency %}24 hr{% else %}Vet{% endif %}</span>
          <strong>{% if v.url %}<a href="{{ v.url }}">{{ v.name }}</a>{% else %}{{ v.name }}{% endif %}</strong>
          <span class="stay-dist">{{ v.nearest }} km · {{ v.nearest | driveTime }}</span>
          <button type="button" class="stay-focus" data-stay="{{ v.slug }}">Show on map</button>
        </p>
        <dl class="stay-facts">
          {% if v.address %}<dt>Address</dt><dd>{{ v.address }}</dd>{% endif %}
          {% if v.hours %}<dt>Cover</dt><dd>{{ v.hours }}</dd>{% endif %}
          <dt>Phone</dt>
          <dd>{% if v.phone %}<a href="tel:{{ v.phone | replace(" ", "") }}">{{ v.phone }}</a>{% else %}<span class="unsure">Not recorded yet</span>{% endif %}</dd>
          {% if v | directions %}<dt>Map</dt><dd><a class="stay-directions" href="{{ v | directions }}">Open in Google Maps</a></dd>{% endif %}
        </dl>
        {% if v.notes %}<p class="stay-notes"><span class="notes-label">Notes</span> {{ v.notes }}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
    {% endif %}
  </section>
  {% endif %}

</article>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""></script>
<script src="https://unpkg.com/leaflet-gpx@1.7.0/gpx.js"></script>
<script src="{{ '/assets/js/map-section.js' | asset }}"></script>
<script src="{{ '/assets/js/stays.js' | asset }}"></script>
