---
layout: layouts/base.njk
---
{% from "macros/entry.njk" import row, contact, checked, heading %}
<article class="section">
  <div class="section-head">
    <p class="section-meta">
      Section {{ order }}{% if region %} · {{ region | regionName }}{% endif %}
    </p>
    <h1>{{ title }}</h1>
    <p class="section-route">{{ startPlace.name or start }} &rarr; {{ endPlace.name or end }}</p>
  </div>

  {% set nav = collections.sections | sectionNav(page.url) %}
  <nav class="section-nav" aria-label="Sections">
    {% if nav.prev %}
    <a class="nav-prev" href="{{ nav.prev.url }}">
      <span class="nav-arrow" aria-hidden="true">&larr;</span>
      <span class="nav-label">{{ nav.prev.order }} · {{ nav.prev.title }}</span>
    </a>
    {% else %}<span class="nav-none"></span>{% endif %}
    <span class="nav-count">{{ nav.position }} of {{ nav.total }}</span>
    {% if nav.next %}
    <a class="nav-next" href="{{ nav.next.url }}">
      <span class="nav-label">{{ nav.next.order }} · {{ nav.next.title }}</span>
      <span class="nav-arrow" aria-hidden="true">&rarr;</span>
    </a>
    {% else %}<span class="nav-none"></span>{% endif %}
  </nav>

  <nav class="section-jump" aria-label="On this page">
    {% if content %}<a href="#notes">Notes</a>{% endif %}
    {% if services.length or transfers.length or transitLink %}<a href="#transport">Transport</a>{% endif %}
    {% if nearby.escape.length %}<a href="#escapes">Escapes</a>{% endif %}
    {% if nearby.poi.length %}<a href="#poi">Worth a look</a>{% endif %}
    {% if nearby.food.length %}<a href="#food">Food</a>{% endif %}
    {% if nearby.shop.length %}<a href="#shops">Shops</a>{% endif %}
    {% if nearby.stay.length %}<a href="#stays">Stays</a>{% endif %}
    {% if nearby.hospital.length or nearby.vet.length %}<a href="#emergencies">Emergencies</a>{% endif %}
  </nav>

  {% if gpx %}
  <div
    class="map map-section"
    data-gpx="{{ gpx | url }}"
    data-tiles="{{ site.tiles.url }}"
    data-attribution="{{ site.tiles.attribution }}"
    data-maxzoom="{{ site.tiles.maxZoom }}"
    data-route="{{ site.route | dump }}"
    data-stays="{{ mapPins | staysForMap | dump }}"
    role="img"
    aria-label="Route map from {{ startPlace.name or start }} to {{ endPlace.name or end }}"
  ></div>
  {% endif %}

  {% if os_url %}
  {# Plain link, no target: gives the OS Maps app first refusal on a phone. #}
  <p class="map-link"><a href="{{ os_url }}">Open this route in OS Maps</a></p>
  {% endif %}

  <dl class="facts">
    {% if distance_km %}<dt>Distance</dt><dd>{{ distance_km }} km</dd>{% endif %}
    {% if ascent_m %}<dt>Ascent</dt><dd>{{ ascent_m }} m</dd>{% endif %}
    {% if mode %}<dt>Approach</dt><dd>{{ mode }}</dd>{% endif %}
  </dl>

  {% if content %}
  <section class="notes" id="notes">{{ content | safe }}</section>
  {% endif %}

  {% if services.length or transfers.length or transitLink %}
  <section class="logistics">
    {{ heading("Transport", "transport") }}

    {% if transitLink %}
    <p class="transit-all">
      <a class="stay-directions" href="{{ transitLink }}">All public transport from {{ startPlace.name }} to {{ endPlace.name }}</a>
      <span class="transit-note">Walking distances below are straight-line.</span>
    </p>
    {% endif %}

    {% if services.length %}
    <ul class="entry-list">
      {% for r in services %}
      {% call row(r, "service", r.provider.name, r.number + " · " + (r.linksEnds and "links both ends" or (r.stretch and "a walk at one end" or "escape points only"))) %}
        <dl class="stay-facts">
          <dt>Calls at</dt>
          <dd>{% for c in r.calling %}{{ c.name }}{% if not loop.last %}, {% endif %}{% endfor %}</dd>
          <dt>Walk to it</dt>
          <dd>
            {% if r.fromStart.km <= 0.2 and r.fromEnd.km <= 0.2 %}Stops at both ends
            {% else %}
              {% if r.fromStart.km > 0.2 %}{{ r.fromStart.km }} km from {{ startPlace.name }} to {{ r.fromStart.stop.name }}{% else %}Stops at {{ startPlace.name }}{% endif %};
              {% if r.fromEnd.km > 0.2 %}{{ r.fromEnd.km }} km from {{ endPlace.name }} to {{ r.fromEnd.stop.name }}{% else %}stops at {{ endPlace.name }}{% endif %}
            {% endif %}
          </dd>
          <dt>Season</dt>
          <dd>{% if r.season %}{{ r.season | seasonText }}{% if r.frequency %} · {{ r.frequency }}{% endif %}{% else %}<span class="unsure">Not confirmed</span>{% endif %}</dd>
          {% if r.servesEscape %}<dt>Bail-out</dt><dd>Calls at escape points on this section</dd>{% endif %}
          {% if r.url %}<dt>Timetable</dt><dd><a href="{{ r.url }}">{{ r.provider.name }}</a></dd>{% endif %}
        </dl>
        {% if r.notes %}<p class="stay-notes"><span class="notes-label">Notes</span> {{ r.notes }}</p>{% endif %}
        {{ checked(r) }}
      {% endcall %}
      {% endfor %}
    </ul>
    {% endif %}

    {% if transfers.length %}
    <h3>Lifts &amp; luggage</h3>
    <ul class="entry-list">
      {% for t in transfers %}
      {% call row(t, "transfer", ("passenger" in t.services) and "Lifts & luggage" or "Luggage", (t.distanceKm == null) and t.reaches or ("based " + t.distanceKm + " km from " + t.reaches)) %}
        <dl class="stay-facts">
          {% if t.hours %}<dt>Hours</dt><dd>{{ t.hours }}</dd>{% endif %}
          <dt>Dogs</dt>
          <dd>
            {% if t.dogs === true %}<span class="yes">Welcome</span>
            {% elif t.dogs === false %}<span class="no">Not allowed</span>
            {% else %}<span class="unsure">Not confirmed</span>{% endif %}
            {% if t.dogs_note %} — {{ t.dogs_note }}{% endif %}
          </dd>
          {{ contact(t) }}
        </dl>
        {% if t.notes %}<p class="stay-notes"><span class="notes-label">Notes</span> {{ t.notes }}</p>{% endif %}
        {{ checked(t) }}
      {% endcall %}
      {% endfor %}
    </ul>
    {% endif %}
  </section>
  {% endif %}

  {% if nearby.escape.length %}
  <section class="escapes">
    {{ heading("Escape points", "escapes") }}
    <ul class="entry-list">
      {% for e in nearby.escape %}
      {% call row(e, "escape", "Escape point", e.kmAlong + " km in · " + e.toRoute + " km off the path") %}
        <dl class="stay-facts">
          {% if e.escape.detail %}<dt>Getting out</dt><dd>{{ e.escape.detail }}</dd>{% endif %}
          {{ contact(e) }}
        </dl>
      {% endcall %}
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if nearby.poi.length %}
  <section class="poi">
    {{ heading("Worth a look", "poi") }}
    <ul class="entry-list">
      {% for p in nearby.poi %}
      {% call row(p, "poi", "", p.kmAlong + " km in · " + p.toRoute + " km off the path") %}
        <dl class="stay-facts">
          {{ contact(p) }}
        </dl>
        {% if p.notes %}<p class="stay-notes"><span class="notes-label">Notes</span> {{ p.notes }}</p>{% endif %}
        {{ checked(p) }}
      {% endcall %}
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if nearby.food.length %}
  <section class="food">
    {{ heading("Food & drink", "food") }}
    <ul class="entry-list">
      {% for f in nearby.food %}
      {% call row(f, "food", f | roleLabel("food"), f.toRoute + " km off the path") %}
        <dl class="stay-facts">
          {% if f.isolation %}<dt>Nearest other</dt><dd>{{ f.isolation }} km away</dd>{% endif %}
          {{ contact(f) }}
        </dl>
        {% if f.notes %}<p class="stay-notes"><span class="notes-label">Notes</span> {{ f.notes }}</p>{% endif %}
        {{ checked(f) }}
      {% endcall %}
      {% endfor %}
    </ul>
    {% if nearby.counts.food > nearby.food.length %}
    <p class="more-note">{{ nearby.counts.food - nearby.food.length }} more within reach, mostly in the towns.</p>
    {% endif %}
    {% if eat %}<p class="more-note">{{ eat }}</p>{% endif %}
  </section>
  {% endif %}

  {% if nearby.shop.length %}
  <section class="shops">
    {{ heading("Shops", "shops") }}
    <ul class="entry-list">
      {% for sh in nearby.shop %}
      {% call row(sh, "shop", sh | roleLabel("shop"), sh.toRoute + " km off the path") %}
        <dl class="stay-facts">
          {% if sh.isolation %}<dt>Nearest other</dt><dd>{{ sh.isolation }} km away</dd>{% endif %}
          {{ contact(sh) }}
        </dl>
        {% if sh.notes %}<p class="stay-notes"><span class="notes-label">Notes</span> {{ sh.notes }}</p>{% endif %}
        {{ checked(sh) }}
      {% endcall %}
      {% endfor %}
    </ul>
    {% if nearby.counts.shop > nearby.shop.length %}
    <p class="more-note">{{ nearby.counts.shop - nearby.shop.length }} more within reach.</p>
    {% endif %}
    {% if shops %}<p class="more-note">{{ shops }}</p>{% endif %}
  </section>
  {% endif %}

  {% if nearby.stay.length %}
  <section class="stays">
    {{ heading("Staying nearby", "stays") }}
    <ul class="entry-list">
      {% for s in nearby.stay %}
      {% call row(s, "stay", s.stay.type | stayType, s.nearest + " km from the " + (s.atEnd and "finish" or "start")) %}
        <dl class="stay-facts">
          <dt>Dogs</dt>
          <dd>
            {% if s.stay.dogs === true %}<span class="yes">Welcome</span>
            {% elif s.stay.dogs === false %}<span class="no">Not allowed</span>
            {% else %}<span class="unsure">Not confirmed</span>{% endif %}
            {% if s.stay.dogs_note %} — {{ s.stay.dogs_note }}{% endif %}
          </dd>
          <dt>Season</dt>
          <dd>{% if s.stay.season %}{{ s.stay.season | seasonText }}{% else %}<span class="unsure">{{ s.stay.season | seasonText }}</span>{% endif %}</dd>
          <dt>Price</dt>
          <dd>{% if s.stay.price_per_night %}{{ s.stay.price_per_night | priceText(s.stay.price_note) }}{% else %}<span class="unsure">{{ s.stay.price_per_night | priceText(s.stay.price_note) }}</span>{% endif %}</dd>
          {% if s.stay.hookup %}<dt>Hook-up</dt><dd>Electric hook-up available</dd>{% endif %}
          {{ contact(s) }}
        </dl>
        {% if s.notes %}<p class="stay-notes"><span class="notes-label">Notes</span> {{ s.notes }}</p>{% endif %}
        {{ checked(s) }}
      {% endcall %}
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if nearby.hospital.length or nearby.vet.length %}
  <section class="emergency">
    {{ heading("Emergencies", "emergencies") }}

    {% if nearby.hospital.length %}
    <h3>Hospitals</h3>
    <ul class="entry-list">
      {% for h in nearby.hospital %}
      {% call row(h, "hospital", (h.hospital.type == "ae") and "A&E" or "Urgent care", h.nearest + " km · " + (h.nearest | driveTime)) %}
        <dl class="stay-facts">
          {% if h.hours %}<dt>Open</dt><dd>{{ h.hours }}</dd>{% endif %}
          {{ contact(h) }}
        </dl>
        {% if h.notes %}<p class="stay-notes"><span class="notes-label">Notes</span> {{ h.notes }}</p>{% endif %}
      {% endcall %}
      {% endfor %}
    </ul>
    {% endif %}

    {% if nearby.vet.length %}
    <h3>Vets</h3>
    <ul class="entry-list">
      {% for v in nearby.vet %}
      {% call row(v, "vet", v.vet.emergency and "24 hr" or "Vet", v.nearest + " km · " + (v.nearest | driveTime)) %}
        <dl class="stay-facts">
          {% if v.hours %}<dt>Cover</dt><dd>{{ v.hours }}</dd>{% endif %}
          {{ contact(v) }}
        </dl>
        {% if v.notes %}<p class="stay-notes"><span class="notes-label">Notes</span> {{ v.notes }}</p>{% endif %}
      {% endcall %}
      {% endfor %}
    </ul>
    {% endif %}
  </section>
  {% endif %}
</article>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""></script>
<script src="https://unpkg.com/leaflet-gpx@1.7.0/gpx.js"></script>
<script src="{{ '/assets/js/map-section.js' | asset }}"></script>
<script src="{{ '/assets/js/stays.js' | asset }}"></script>
