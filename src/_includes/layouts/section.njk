---
layout: layouts/base.njk
---
<article class="section">
  <div class="section-head">
    <p class="section-meta">
      Section {{ order }}{% if region %} · {{ region | regionName }}{% endif %}
    </p>
    <h1>{{ title }}</h1>
    <p class="section-route">{{ start }} &rarr; {{ end }}</p>
  </div>

  {% if gpx %}
  <div
    class="map map-section"
    data-gpx="{{ gpx | url }}"
    data-tiles="{{ site.tiles.url }}"
    data-attribution="{{ site.tiles.attribution }}"
    data-maxzoom="{{ site.tiles.maxZoom }}"
    data-route="{{ site.route | dump }}"
    role="img"
    aria-label="Route map from {{ start }} to {{ end }}"
  ></div>
  {% endif %}

  {% if os_url %}
  {# Plain link, no target: gives the OS Maps app first refusal on a phone. #}
  <p class="map-link"><a href="{{ os_url }}">Open this route in OS Maps</a></p>
  {% endif %}

  <dl class="facts">
    {% if distance_km %}<dt>Distance</dt><dd>{{ distance_km }} km</dd>{% endif %}
    {% if ascent_m %}<dt>Ascent</dt><dd>{{ ascent_m }} m</dd>{% endif %}
    {% if mode %}<dt>Approach</dt><dd>{{ mode }}</dd>{% endif %}
  </dl>

  {% if transport or shops or eat %}
  <section class="logistics">
    <h2>Getting there &amp; back</h2>
    {% if transport %}
    <ul class="transport">
      {% for t in transport %}
      <li>
        <span class="t-type">{{ t.type }}</span>
        {% if t.url %}<a href="{{ t.url }}">{{ t.detail }}</a>{% else %}{{ t.detail }}{% endif %}
        {% if t.season %}<span class="t-season">{{ t.season }}</span>{% endif %}
      </li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if shops %}<p><strong>Shops &amp; dog food:</strong> {{ shops }}</p>{% endif %}
    {% if eat %}<p><strong>Eating out:</strong> {{ eat }}</p>{% endif %}
  </section>
  {% endif %}

  {% if escape_points %}
  <section class="escapes">
    <h2>Escape points</h2>
    <ul class="escape-list">
      {% for e in escape_points %}
      <li>
        {% if e.km %}<span class="e-km">{{ e.km }} km</span>{% endif %}
        <strong>{{ e.name }}</strong>{% if e.detail %} — {{ e.detail }}{% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if stays and stays.length %}
  <section class="stays">
    <h2>Staying nearby</h2>
    <ul class="stay-list">
      {% for s in stays %}
      <li>
        <p class="stay-head">
          <span class="stay-type">{{ s.type | stayType }}</span>
          <strong>{% if s.url %}<a href="{{ s.url }}">{{ s.name }}</a>{% else %}{{ s.name }}{% endif %}</strong>
          <span class="stay-dist">{{ s.nearest }} km from the {% if s.atEnd %}finish{% else %}start{% endif %}{% if s.toRoute <= 0.25 %}, on the route{% elif s.toRoute < (s.nearest - 0.3) %}, {{ s.toRoute }} km off the path{% endif %}</span>
        </p>
        <p class="stay-meta">
          {% if s.address %}{{ s.address }}{% endif %}
          {% if s.phone %} · <a href="tel:{{ s.phone | replace(" ", "") }}">{{ s.phone }}</a>{% endif %}
          {% if s.email %} · <a href="mailto:{{ s.email }}">{{ s.email }}</a>{% endif %}
        </p>
        <p class="stay-meta">
          {% if s.dogs === true %}<span class="yes">Dogs welcome</span>{% elif s.dogs === false %}<span class="no">No dogs</span>{% else %}<span class="unsure">Dog policy unconfirmed</span>{% endif %}
          {% if s.dogs_note %} — {{ s.dogs_note }}{% endif %}
          {% if s.hookup %} · Electric hook-up{% endif %}
          {% if s.price %} · {{ s.price }}{% endif %}
          {% if s.season %} · {{ s.season }}{% endif %}
        </p>
        {% if s.note %}<p class="stay-meta">{{ s.note }}</p>{% endif %}
        <p class="stay-meta">
          {% if s.verified %}<span class="checked">Checked {{ s.verified }}</span>{% else %}<span class="unsure">Details not yet confirmed with the owner</span>{% endif %}
        </p>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if content %}
  <section class="notes">{{ content | safe }}</section>
  {% endif %}
</article>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""></script>
<script src="https://unpkg.com/leaflet-gpx@1.7.0/gpx.js"></script>
<script src="/assets/js/map-section.js"></script>
