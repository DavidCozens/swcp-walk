{# One shape for every list on a section page: badge, name, role, one key fact,
   a jump to its pin, and the detail behind a disclosure. Sections differ in
   what they put inside; they shouldn't differ in how they look. #}
{% macro row(loc, role, label, fact) %}
<li>
  <details class="entry">
    <summary>
      {{ loc | locBadge | safe }}
      <span class="stay-name">{{ loc.name }}</span>
{% if label %}<span class="stay-kind">{{ label }}</span>{% endif %}
      <span class="stay-dist">{{ fact }}</span>
      {% if loc.slug %}<button type="button" class="stay-focus" data-stay="{{ loc.slug }}">Show on map</button>{% endif %}
    </summary>
    {{ caller() }}
  </details>
</li>
{% endmacro %}

{# Address, phone and a map link — the three things nearly every entry needs. #}
{% macro contact(loc) %}
  {% if loc.address %}<dt>Address</dt><dd>{{ loc.address }}</dd>{% endif %}
  {% if loc.phone %}<dt>Phone</dt><dd><a href="tel:{{ loc.phone | replace(" ", "") }}">{{ loc.phone }}</a></dd>{% endif %}
  {% if loc.url %}<dt>Website</dt><dd><a href="{{ loc.url }}">{{ loc.name }}</a></dd>{% endif %}
  {% if loc | directions %}
  <dt>Get there</dt>
  <dd class="get-there">
    {# No origin, so Maps routes from wherever you're standing. #}
    <a class="stay-directions" href="{{ loc | directions('driving') }}">Drive</a>
    <a class="stay-directions" href="{{ loc | directions('transit') }}">Public transport</a>
    <a class="stay-directions" href="{{ loc | directions('walking') }}">Walk</a>
  </dd>
  {% endif %}
{% endmacro %}

{% macro checked(loc) %}
<p class="stay-checked">
  {% if loc.verified %}Checked {{ loc.verified }}{% else %}<span class="unsure">Not confirmed</span>{% endif %}
</p>
{% endmacro %}

{# Every section gets the same control, however short. Whole sections are
   irrelevant depending on why you've opened the page — a hurt dog, a hungry
   afternoon, two days of transport to plan — so each folds away on its own. #}
{% macro heading(title, id) %}
<div class="stays-head">
  <h2 id="{{ id }}">{{ title }}</h2>
  <button type="button" class="stays-toggle" data-expand-all>Expand all</button>
</div>
{% endmacro %}
