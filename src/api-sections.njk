---
permalink: "/api/sections.json"
eleventyExcludeFromCollections: true
---
[
{%- for s in collections.sections -%}
  {%- set gpxUrl = (s.data.gpx | url) if s.data.gpx else "" -%}
  {
    "title": {{ s.data.title | dump | safe }},
    "url": {{ (s.url | url) | dump | safe }},
    "order": {{ s.data.order or 0 }},
    "crossing": {{ "true" if s.data.crossing else "false" }},
    "region": {{ (s.data.region or "") | dump | safe }},
    "gpx": {{ gpxUrl | dump | safe }},
    "points": {{ (s.data.samplePoints or []) | dump | safe }}
  }{% if not loop.last %},{% endif %}
{%- endfor -%}
]
